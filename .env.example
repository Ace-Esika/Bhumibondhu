# ---------------------------------------------------------------------------
# Bhumipedia RAG chatbot — copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------
# development | production | test
APP_ENV=development
LOG_LEVEL=INFO
# structured JSON logs (set false for local reading)
LOG_JSON=true
DEBUG_LOG_QUERIES=false

# --- PostgreSQL + pgvector (docker compose overrides this for containers) ---
DATABASE_URL=postgresql+psycopg://bhumipedia:bhumipedia@localhost:5433/bhumipedia
POSTGRES_USER=bhumipedia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bhumipedia
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Redis (optional: caching + distributed rate limiting) ---
REDIS_URL=redis://localhost:6380/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# --- Source APIs ---
SOURCE_API_BASE_URL=https://bhumipedia.land.gov.bd
SOURCE_API_TIMEOUT_SECONDS=180
SYNC_SOURCE_TYPES=ebook,blog,forum,qna_type1,qna_type2
# The API exposes no public page URLs; citations use the record's real PDF link.
# If you know the portal's page pattern, set it (placeholders: {id}, and {group} for topics).
EBOOK_URL_TEMPLATE=
BLOG_URL_TEMPLATE=
FORUM_TOPIC_URL_TEMPLATE=
# Placeholder/test records present in the live data are excluded from search ("" disables).
EXCLUDE_TITLE_REGEX=(?i)^\s*test\b

# --- Scheduled sync (worker) ---
SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=6
SYNC_ON_STARTUP=true
SYNC_MAX_DELETE_FRACTION=0.3

# --- Chunking (model tokens) ---
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=80

# --- Embeddings: BAAI/bge-m3 via LangChain HuggingFaceEmbeddings (self-hosted) ---
# local | hf_endpoint (HF Inference API; needs HF_API_TOKEN)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# cpu | cuda | auto
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
# model cache dir (compose uses the model_cache volume)
HF_HOME=
# true once weights are cached: no Hugging Face network calls
HF_HUB_OFFLINE=false
HF_API_TOKEN=

# --- Reranker: BAAI/bge-reranker-v2-m3 (slow on CPU: ~2 s per candidate) ---
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_TOP_K=20
RERANKER_MAX_LENGTH=512

# --- Retrieval ---
VECTOR_TOP_K=30
LEXICAL_TOP_K=30
FINAL_CONTEXT_K=5
# linear | rrf  (linear 0.7/0.3 won the benchmark, README §10)
FUSION_METHOD=linear
VECTOR_WEIGHT=0.7
LEXICAL_WEIGHT=0.3
AUTHORITY_BOOST=0.02
SECTION_MATCH_BOOST=0.25
MIN_VECTOR_SIMILARITY=0.50
MIN_RERANK_SCORE=0.05

# --- LLM: Groq ---
GROQ_API_KEY=
# list available models: python -m app.cli groq-models
GROQ_MODEL=
# optional: answers with this model when GROQ_MODEL is rate limited (e.g. daily token quota)
GROQ_FALLBACK_MODEL=
# Per-request token limits of your Groq tier (0 = unlimited). Free tier: 6000 / 7800.
LLM_MAX_INPUT_TOKENS=0
LLM_MAX_TOTAL_TOKENS=0
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=3

# --- Conversation history (stored in PostgreSQL) ---
CONVERSATION_ENABLED=true
# messages (user+assistant) of history given to the LLM, and their character budget
CONVERSATION_HISTORY_TURNS=6
CONVERSATION_HISTORY_CHARS=2500
CONVERSATION_RETENTION_DAYS=30
# rewrite context-dependent follow-ups ("এর ফি কত?") into standalone questions before retrieval
CONDENSE_FOLLOWUPS=true
# model for that rewrite ("" = GROQ_MODEL); a small/separate model saves the main model's quota
GROQ_CONDENSE_MODEL=

# --- API security ---
# required in production; generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# comma-separated; empty = /api/chat is public
PUBLIC_API_KEYS=
# comma-separated allowed browser origins
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGE_CHARS=1000
REQUEST_TIMEOUT_SECONDS=90
# true only behind a trusted reverse proxy
TRUST_FORWARDED_FOR=false
